APP_DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/quote_costing
APP_DEBUG=true

# OpenSCAD (SCAD-режим расчёта): kill-switch и путь к бинарнику.
# Автопоиск: backend/vendor (scripts/download_openscad.ps1) -> PATH -> Program Files
# Ставится Manifold-снапшот (быстрое ядро); таймаут по умолчанию 60 с
APP_OPENSCAD_ENABLED=true
# APP_OPENSCAD_BIN=C:\path\to\openscad.com
# APP_OPENSCAD_TIMEOUT_S=60
# APP_SCAD_MAX_STL_MB=50
